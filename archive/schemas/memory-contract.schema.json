{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stylemate:memory-contract:0.2",
  "title": "StyleMate memory contract v0.2",
  "description": "Accepted review-time contract for request lifetime, memory, evidence, retrieval, intent and atomic memory batches. This schema is not a product implementation, database contract, authentication boundary, or LLM output authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/memoryItem"
    },
    {
      "$ref": "#/$defs/userEvidence"
    },
    {
      "$ref": "#/$defs/batch"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/batchResult"
    },
    {
      "$ref": "#/$defs/contextResult"
    },
    {
      "$ref": "#/$defs/intentDecision"
    },
    {
      "$ref": "#/$defs/retentionPolicy"
    },
    {
      "$ref": "#/$defs/deletionReceipt"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "contractVersion": {
      "const": "0.2"
    },
    "contractType": {
      "type": "string",
      "enum": [
        "request",
        "memory_item",
        "user_evidence",
        "batch",
        "event",
        "batch_result",
        "context_result",
        "intent_decision",
        "retention_policy"
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/nonblank"
        },
        "value": {
          "$ref": "#/$defs/nonblank"
        },
        "polarity": {
          "enum": [
            "prefer",
            "avoid",
            "require"
          ]
        },
        "strength": {
          "enum": [
            "soft",
            "hard"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "polarity",
        "strength"
      ],
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/nonblank"
        },
        "value": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "uniqueItems": true
        },
        "valid_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "condition",
        "predicates",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "userRef": {
      "type": "object",
      "properties": {
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "user_id",
        "input_ref",
        "occurred_at"
      ],
      "additionalProperties": false
    },
    "evidenceSnapshot": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/nonblank"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "$ref": "#/$defs/applicability"
        },
        "selected_aspects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          },
          "uniqueItems": true
        },
        "authorized_roles": {
          "type": "array",
          "items": {
            "enum": [
              "content",
              "content_confirmation",
              "long_term_approval",
              "replacement",
              "withdrawal",
              "deletion"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_memory_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/claim"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "content",
        "condition",
        "period",
        "selected_aspects",
        "authorized_roles",
        "target_memory_ids",
        "claim"
      ],
      "additionalProperties": false
    },
    "userEvidence": {
      "type": "object",
      "properties": {
        "contract_type": {
          "const": "user_evidence"
        },
        "schema_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "snapshot_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "user_message",
            "image_feedback",
            "memory_confirmation",
            "ui_action"
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        },
        "image_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/evidenceSnapshot"
        },
        "raw_retention_until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "contract_type",
        "schema_version",
        "input_ref",
        "snapshot_id",
        "user_id",
        "request_id",
        "kind",
        "occurred_at",
        "image_id",
        "snapshot",
        "raw_retention_until"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image_feedback"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "image_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "user_message",
                  "memory_confirmation",
                  "ui_action"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "image_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "short_term"
            },
            "request_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "type",
            "request_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "long_term"
            },
            "approval": {
              "$ref": "#/$defs/approvalRef"
            }
          },
          "required": [
            "type",
            "approval"
          ],
          "additionalProperties": false
        }
      ]
    },
    "approvalRef": {
      "type": "object",
      "properties": {
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "role": {
          "const": "long_term_approval"
        }
      },
      "required": [
        "input_ref",
        "snapshot_ref",
        "user_id",
        "approved_at",
        "role"
      ],
      "additionalProperties": false
    },
    "confirmationRef": {
      "type": "object",
      "properties": {
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "confirmed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "role": {
          "const": "content_confirmation"
        }
      },
      "required": [
        "input_ref",
        "snapshot_ref",
        "user_id",
        "confirmed_at",
        "role"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "state": {
          "enum": [
            "unconfirmed",
            "confirmed"
          ]
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/confirmationRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "basis",
        "state",
        "confirmation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "confirmation": {
                "$ref": "#/$defs/confirmationRef"
              }
            }
          },
          "else": {
            "properties": {
              "confirmation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "candidate",
            "active",
            "superseded",
            "withdrawn"
          ]
        },
        "changed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reason": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "required": [
        "state",
        "changed_at",
        "reason"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "create",
            "promote",
            "replace"
          ]
        },
        "source_memory_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "family_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_redacted": {
          "type": "boolean"
        },
        "source_redaction_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "operation",
        "source_memory_id",
        "family_id"
      ],
      "additionalProperties": false
    },
    "memoryItem": {
      "type": "object",
      "properties": {
        "contract_type": {
          "const": "memory_item"
        },
        "schema_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "content": {
          "$ref": "#/$defs/nonblank"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          },
          "uniqueItems": true
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        }
      },
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "user_id",
        "version",
        "content",
        "tags",
        "claim",
        "scope",
        "applicability",
        "verification",
        "evidence",
        "lifecycle",
        "created_at",
        "lineage"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "state": {
                    "const": "candidate"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "type": {
                    "const": "short_term"
                  }
                }
              },
              "verification": {
                "properties": {
                  "state": {
                    "const": "unconfirmed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "state": {
                    "const": "active"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "state": {
                    "const": "confirmed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "properties": {
                  "type": {
                    "const": "long_term"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "state": {
                    "const": "confirmed"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lineage": {
                "properties": {
                  "operation": {
                    "const": "promote"
                  }
                },
                "required": [
                  "operation"
                ]
              }
            },
            "required": [
              "lineage"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "type": {
                    "const": "long_term"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "properties": {
        "input_ref": {
          "$ref": "#/$defs/identifier"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/identifier"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "content",
              "content_confirmation",
              "long_term_approval",
              "replacement",
              "withdrawal",
              "deletion"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "input_ref",
        "snapshot_ref",
        "roles"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "contract_type": {
          "const": "request"
        },
        "schema_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "onboarding",
            "styling"
          ]
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "cancelled"
          ]
        },
        "revision": {
          "$ref": "#/$defs/version"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "last_activity_at": {
          "$ref": "#/$defs/timestamp"
        },
        "retention_until": {
          "$ref": "#/$defs/timestamp"
        },
        "timezone": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "user_id",
        "kind",
        "status",
        "revision",
        "created_at",
        "last_activity_at",
        "retention_until",
        "timezone"
      ],
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "memory"
            },
            "memory_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "memory_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "output"
            },
            "action_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "action_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "create",
            "confirm",
            "promote",
            "replace",
            "withdraw",
            "add_evidence",
            "delete"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "new_item": {
          "anyOf": [
            {
              "$ref": "#/$defs/memoryItem"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "deletion_scope": {
          "type": "array",
          "items": {
            "enum": [
              "memory",
              "promote_family",
              "request_raw",
              "derived_snapshots",
              "source_spans",
              "summaries",
              "indexes",
              "cache"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "action_id",
        "type",
        "target",
        "depends_on",
        "new_item",
        "evidence",
        "deletion_scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "create"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "none"
                  }
                }
              },
              "new_item": {
                "$ref": "#/$defs/memoryItem"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "confirm",
                  "promote",
                  "withdraw",
                  "add_evidence"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "enum": [
                      "memory",
                      "output"
                    ]
                  }
                }
              },
              "new_item": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "replace"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "memory"
                  }
                }
              },
              "new_item": {
                "$ref": "#/$defs/memoryItem"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "delete"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "memory"
                  }
                }
              },
              "new_item": {
                "type": "null"
              },
              "deletion_scope": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "batch": {
      "type": "object",
      "properties": {
        "contract_type": {
          "const": "batch"
        },
        "schema_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "batch_id": {
          "$ref": "#/$defs/identifier"
        },
        "user_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_request_revision": {
          "$ref": "#/$defs/version"
        },
        "profile_revision": {
          "$ref": "#/$defs/version"
        },
        "context_snapshot_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_versions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
